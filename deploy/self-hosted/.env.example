# Build from the current checkout. Release documentation replaces this with a
# versioned GHCR image reference.
AOP_IMAGE=agent-operator-coordinator:local
AOP_VERSION=0.1.23
AOP_REVISION=dev
AOP_SOURCE=https://github.com/N1arko/agent-operator
AOP_CREATED=1970-01-01T00:00:00Z

# Base/private-network profile.
AOP_PUBLIC_URL=http://127.0.0.1:8787
AOP_ALLOWED_HOSTS=127.0.0.1,localhost
AOP_BIND_ADDRESS=127.0.0.1
AOP_HTTP_PORT=8787

# Set true and configure the domain to enable compose.tls.yaml.
AOP_TLS=false
AOP_DOMAIN=operator.example.com
AOP_HTTP_BIND_ADDRESS=0.0.0.0
AOP_HTTPS_BIND_ADDRESS=0.0.0.0

# bootstrap.sh replaces these with the current Linux user by default.
AOP_UID=1000
AOP_GID=1000
AOP_REQUEST_LEASE_MS=7200000
AOP_MEMORY_LIMIT=512m
AOP_CPU_LIMIT=0.75
AOP_CADDY_MEMORY_LIMIT=192m
AOP_CADDY_CPU_LIMIT=0.25
