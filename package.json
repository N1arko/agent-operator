{
  "name": "agent-operator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm build && node --test dist/test/**/*.test.js",
    "coordinator": "node dist/src/coordinator/main.js",
    "worker": "node dist/src/worker/main.js",
    "diagnose": "node dist/src/worker/main.js diagnose"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0"
  },
  "packageManager": "pnpm@11.9.0"
}
